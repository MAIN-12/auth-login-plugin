{
  "name": "@main12/auth-login",
  "version": "2.2.1",
  "description": "Payload CMS authentication plugin — isolated configuration and guarded native password login",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./client": {
      "import": "./dist/exports/client.js",
      "types": "./dist/exports/client.d.ts",
      "default": "./dist/exports/client.js"
    },
    "./rsc": {
      "import": "./dist/exports/rsc.js",
      "types": "./dist/exports/rsc.d.ts",
      "default": "./dist/exports/rsc.js"
    },
    "./proxy": {
      "import": "./dist/proxy.js",
      "types": "./dist/proxy.d.ts",
      "default": "./dist/proxy.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "docs/migration.md",
    "docs/plugin-contracts.md"
  ],
  "scripts": {
    "build": "pnpm clean && pnpm copyfiles && pnpm build:types && pnpm build:swc && pnpm build:fix-esm-imports",
    "build:fix-esm-imports": "tsx ./scripts/fix-esm-imports.ts",
    "build:swc": "swc ./src -d ./dist --config-file .swcrc --strip-leading-paths",
    "build:types": "tsc --outDir dist",
    "clean": "rimraf {dist,*.tsbuildinfo}",
    "copyfiles": "copyfiles -u 1 \"src/**/*.{html,css,scss,ttf,woff,woff2,eot,svg,jpg,png,json}\" dist/",
    "dev": "next dev dev --turbo",
    "dev:generate-importmap": "pnpm dev:payload generate:importmap",
    "dev:generate-types": "pnpm dev:payload generate:types",
    "dev:payload": "cross-env PAYLOAD_CONFIG_PATH=./dev/payload.config.ts payload",
    "lint": "eslint src tests scripts",
    "lint:fix": "eslint ./src --fix",
    "test": "vitest",
    "typecheck": "tsc --noEmit && pnpm typecheck:scripts",
    "typecheck:scripts": "tsc --project scripts/tsconfig.json",
    "test:unit": "vitest run",
    "test:consumer": "tsx scripts/test-consumer.ts",
    "test:otp:acceptance": "AUTH_CONSUMER_OTP=1 AUTH_CONSUMER_BUNDLER=webpack tsx scripts/test-consumer.ts",
    "test:password:acceptance": "pnpm test:password:sqlite && pnpm test:password:postgres",
    "test:password:sqlite": "AUTH_CONSUMER_PASSWORD=1 AUTH_CONSUMER_DB=sqlite AUTH_CONSUMER_BUNDLER=webpack tsx scripts/test-consumer.ts",
    "test:password:postgres": "AUTH_CONSUMER_PASSWORD=1 AUTH_CONSUMER_OTP=1 AUTH_CONSUMER_BUNDLER=webpack tsx scripts/test-consumer.ts",
    "test:oauth:sqlite": "AUTH_CONSUMER_OAUTH=1 AUTH_CONSUMER_DB=sqlite AUTH_CONSUMER_BUNDLER=webpack tsx scripts/test-consumer.ts",
    "test:oauth:postgres": "AUTH_CONSUMER_OTP=1 AUTH_CONSUMER_OAUTH=1 AUTH_CONSUMER_DB=postgres AUTH_CONSUMER_BUNDLER=webpack tsx scripts/test-consumer.ts",
    "test:oauth:acceptance": "pnpm test:oauth:sqlite && pnpm test:oauth:postgres",
    "test:integration:acceptance": "AUTH_CONSUMER_ISSUE05=1 AUTH_CONSUMER_BUNDLER=webpack tsx scripts/test-consumer.ts",
    "test:migration:acceptance": "AUTH_CONSUMER_ISSUE06=1 AUTH_CONSUMER_OTP=1 AUTH_CONSUMER_BUNDLER=webpack tsx scripts/test-consumer.ts",
    "prepare": "lefthook install",
    "hooks:install": "lefthook install",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@heroui/react": "^3.2.2",
    "@heroui/styles": "^3.2.2",
    "@main12/auth-login": "link:.",
    "@payloadcms/db-postgres": "3.90.2",
    "@payloadcms/db-sqlite": "3.90.2",
    "@payloadcms/next": "3.90.2",
    "@payloadcms/richtext-lexical": "3.90.2",
    "@payloadcms/ui": "3.90.2",
    "@playwright/test": "1.58.2",
    "@swc/cli": "0.6.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "24.12.3",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "copyfiles": "2.4.1",
    "cross-env": "10.1.0",
    "eslint": "^9.23.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "framer-motion": "^12.43.0",
    "happy-dom": "20.11.1",
    "lefthook": "2.1.17",
    "next": "16.3.6",
    "payload": "3.90.2",
    "prettier": "3.9.9",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "rimraf": "3.0.2",
    "sharp": "0.35.5",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vitest": "4.1.6"
  },
  "peerDependencies": {
    "@heroui/react": "3.2.2",
    "framer-motion": "12.43.0",
    "next": "16.3.6",
    "payload": "3.90.2",
    "react": "19.2.6"
  },
  "peerDependenciesMeta": {
    "@heroui/react": {
      "optional": true
    }
  },
  "engines": {
    "node": "^22.0.0 || ^24.0.0"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "import": "./dist/index.js",
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./client": {
        "import": "./dist/exports/client.js",
        "types": "./dist/exports/client.d.ts",
        "default": "./dist/exports/client.js"
      },
      "./rsc": {
        "import": "./dist/exports/rsc.js",
        "types": "./dist/exports/rsc.d.ts",
        "default": "./dist/exports/rsc.js"
      },
      "./proxy": {
        "import": "./dist/proxy.js",
        "types": "./dist/proxy.d.ts",
        "default": "./dist/proxy.js"
      }
    },
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@swc/core",
      "sharp",
      "esbuild"
    ],
    "overrides": {
      "payload>undici": "7.29.1"
    }
  },
  "registry": "https://registry.npmjs.org/",
  "dependencies": {
    "@libsql/client": "0.14.0",
    "drizzle-orm": "0.45.2",
    "jose": "^6.2.12",
    "oauth4webapi": "3.8.8",
    "zod": "4.6.5"
  }
}
