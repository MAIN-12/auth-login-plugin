{
  "name": "@main12/auth-login",
  "version": "2.2.1",
  "description": "Payload CMS authentication plugin \u2014 isolated configuration and guarded native password login",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./client": {
      "import": "./dist/exports/client.js",
      "types": "./dist/exports/client.d.ts",
      "default": "./dist/exports/client.js"
    },
    "./rsc": {
      "import": "./dist/exports/rsc.js",
      "types": "./dist/exports/rsc.d.ts",
      "default": "./dist/exports/rsc.js"
    },
    "./proxy": {
      "import": "./dist/proxy.js",
      "types": "./dist/proxy.d.ts",
      "default": "./dist/proxy.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "pnpm clean && pnpm copyfiles && pnpm build:types && pnpm build:swc && pnpm build:fix-esm-imports",
    "build:fix-esm-imports": "node ./scripts/fix-esm-imports.mjs",
    "build:swc": "swc ./src -d ./dist --config-file .swcrc --strip-leading-paths",
    "build:types": "tsc --outDir dist",
    "clean": "rimraf {dist,*.tsbuildinfo}",
    "copyfiles": "copyfiles -u 1 \"src/**/*.{html,css,scss,ttf,woff,woff2,eot,svg,jpg,png,json}\" dist/",
    "dev": "next dev dev --turbo",
    "dev:generate-importmap": "pnpm dev:payload generate:importmap",
    "dev:generate-types": "pnpm dev:payload generate:types",
    "dev:payload": "cross-env PAYLOAD_CONFIG_PATH=./dev/payload.config.ts payload",
    "lint": "eslint src tests",
    "lint:fix": "eslint ./src --fix",
    "test": "vitest",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run",
    "test:consumer": "node scripts/test-consumer.mjs"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@heroui/react": "^3.2.2",
    "@heroui/styles": "^3.2.2",
    "@main12/auth-login": "link:.",
    "@payloadcms/db-sqlite": "3.90.2",
    "@payloadcms/next": "3.90.2",
    "@payloadcms/richtext-lexical": "3.90.2",
    "@payloadcms/ui": "3.90.2",
    "@playwright/test": "1.58.2",
    "@swc/cli": "0.6.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "24.12.3",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "copyfiles": "2.4.1",
    "cross-env": "10.1.0",
    "eslint": "^9.23.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "framer-motion": "^12.43.0",
    "happy-dom": "20.11.1",
    "next": "16.3.6",
    "payload": "3.90.2",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "rimraf": "3.0.2",
    "sharp": "0.35.4",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vitest": "4.1.6"
  },
  "peerDependencies": {
    "@heroui/react": ">=3.2.0",
    "framer-motion": ">=12.0.0",
    "next": "^16.3.3",
    "next-intl": "*",
    "payload": "^3.90.0",
    "react": "^19.0.0"
  },
  "peerDependenciesMeta": {
    "@heroui/react": {
      "optional": true
    },
    "next-intl": {
      "optional": true
    }
  },
  "engines": {
    "node": "^22.0.0"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "import": "./dist/index.js",
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./client": {
        "import": "./dist/exports/client.js",
        "types": "./dist/exports/client.d.ts",
        "default": "./dist/exports/client.js"
      },
      "./rsc": {
        "import": "./dist/exports/rsc.js",
        "types": "./dist/exports/rsc.d.ts",
        "default": "./dist/exports/rsc.js"
      },
      "./proxy": {
        "import": "./dist/proxy.js",
        "types": "./dist/proxy.d.ts",
        "default": "./dist/proxy.js"
      }
    },
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@swc/core",
      "sharp",
      "esbuild"
    ]
  },
  "registry": "https://registry.npmjs.org/",
  "dependencies": {
    "@iconify/react": "6.0.2",
    "jose": "^6.2.12"
  }
}
